[Unit]
Description=Bot de trading crypto
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Adapter le chemin ci-dessous à l'emplacement réel du projet sur le Raspberry Pi
WorkingDirectory=/home/pi/bot
ExecStart=/home/pi/bot/.venv/bin/python /home/pi/bot/main.py run
Restart=on-failure
RestartSec=10
User=pi
Environment=PYTHONUNBUFFERED=1

# Limites raisonnables pour un Raspberry Pi 3 (1 Go de RAM)
MemoryMax=400M
Nice=5

[Install]
WantedBy=multi-user.target

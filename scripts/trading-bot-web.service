[Unit]
Description=Dashboard web du bot de trading
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Adapter le chemin ci-dessous à l'emplacement réel du projet sur le Raspberry Pi
WorkingDirectory=/home/pi/bot
ExecStart=/home/pi/bot/.venv/bin/python /home/pi/bot/main.py web
Restart=on-failure
RestartSec=10
User=pi
Environment=PYTHONUNBUFFERED=1

MemoryMax=150M
Nice=10

[Install]
WantedBy=multi-user.target

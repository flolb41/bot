[Unit]
Description=Collecte Simple Earn du bot (compte réel, sans trading)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/home/florian/bot
ExecStart=/home/florian/bot/.venv/bin/python /home/florian/bot/main.py rewards collect --live
User=florian
Environment=PYTHONUNBUFFERED=1
MemoryMax=200M
Nice=10

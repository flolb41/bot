# Crypto Reward Hunter — bot d'arbitrage inter-DEX — variables d'environnement.
#
# RÈGLE D'OR : ne JAMAIS mettre de seed phrase ni de private key en clair dans ce
# fichier, ni nulle part ailleurs dans le dépôt. Les wallets ci-dessous sont
# chiffrés sur disque au format keystore Ethereum V3 ; seule la passphrase de
# déchiffrement (ou le mot de passe du dashboard) apparaît ici.

# --- Telegram --------------------------------------------------------------
# Crée un bot via @BotFather, puis récupère ton chat_id via @userinfobot.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- RPC (lecture + envoi de transactions sur la chaîne de trading) --------
# Liste ORDONNÉE d'endpoints Base, séparés par des virgules : le premier est le
# principal, les suivants prennent le relais automatiquement en cas de
# rate-limit (429) ou de panne, puis les endpoints publics gratuits sont
# ajoutés d'office en dernier recours (voir app/trading/rpc.py). Exemple :
# RPC_BASE=https://base-mainnet.infura.io/v3/<clé>,https://base-mainnet.g.alchemy.com/v2/<clé>
RPC_BASE=https://mainnet.base.org

# --- Wallet de TRADING (bot d'arbitrage) ------------------------------------
# Importé via `python main.py import-trading-wallet` (wallet MetaMask principal
# de l'utilisateur, exécuté en direct en SSH sur le Pi — jamais via un script
# tiers). La clé privée est chiffrée au format keystore Ethereum V3 ; ce fichier
# ne contient que la passphrase de déchiffrement et le chemin du keystore.
WALLET_TRADING_KEYSTORE_PATH=data/trading_keystore.json
WALLET_TRADING_PASSPHRASE=
# Garde-fous obligatoires avant toute exécution réelle (voir app/trading/guardrails.py) :
# 1. trading.enabled: true dans config/config.yaml
# 2. TRADING_ENABLED=true ci-dessous
# 3. TRADING_LIVE_CONFIRMED="<phrase exacte>" ci-dessous (voir guardrails.py::LIVE_CONFIRMATION_PHRASE)
TRADING_ENABLED=false
TRADING_LIVE_CONFIRMED=

# --- Wallet AUTO-SIGNATURE (keystore historique, toujours utilisé par le
# chargeur de clé `app/wallet/signer.py::load_signer`) -----------------------
WALLET_AUTOSIGNER_KEYSTORE_PATH=data/autosigner_keystore.json
WALLET_AUTOSIGNER_PASSPHRASE=

# --- Dashboard (optionnel, si exposé au-delà du LAN) ------------------------
DASHBOARD_BASIC_AUTH_PASSWORD=

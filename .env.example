# Crypto Reward Hunter — variables d'environnement.
#
# RÈGLE D'OR : ne JAMAIS mettre de seed phrase ni de private key dans ce fichier,
# ni nulle part ailleurs dans le dépôt. Seules des ADRESSES PUBLIQUES de wallets
# sont utilisées (lecture seule des balances/allowances).

# --- Telegram --------------------------------------------------------------
# Crée un bot via @BotFather, puis récupère ton chat_id via @userinfobot.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- RPC endpoints (lecture seule des balances on-chain) -------------------
# Clé = RPC_<NETWORK> où <NETWORK> est le champ `network` du wallet, normalisé
# en MAJUSCULES et caractères non alphanumériques remplacés par "_".
# Exemples (à adapter selon les réseaux réellement utilisés) :
RPC_PUSH_CHAIN_DONUT_TESTNET=
RPC_ANALOG_TESTNET_SUBSTRATE_EVM_VIA_GMP=
RPC_KRYVORA_ETHEREUM_LAYER_2_TESTNET=
RPC_ROBINHOOD_CHAIN_TESTNET=

# --- Wallet FARMING (adresses publiques uniquement) -------------------------
# La seed/private key de ce wallet doit rester hors ligne (section 4 du TODO) :
# crée-le dans MetaMask/Rabby (ou un hardware wallet), PUIS copie uniquement
# l'adresse publique (0x...) ici. Ne jamais coller une seed phrase ou une
# private key dans ce fichier.
WALLET_FARM_EVM_ADDRESS=
# Nom du réseau à utiliser pour lire la balance (doit correspondre à une clé
# RPC_<NETWORK> ci-dessus, ex: PUSH_CHAIN_DONUT_TESTNET).
WALLET_FARM_EVM_NETWORK=
WALLET_REWARDS_EVM_ADDRESS=
WALLET_REWARDS_EVM_NETWORK=

# --- Wallet AUTO-SIGNATURE (Phase 4 — exception strictement limitée) -------
# Seule exception à la "RÈGLE D'OR" ci-dessus : ce wallet est généré DIRECTEMENT
# sur le RPi3 via `python main.py create-autosigner-wallet`, qui chiffre la clé
# privée au format keystore Ethereum V3 (jamais de clé en clair sur disque, ni
# dans ce fichier, ni dans Git). Ce doit être un wallet SÉPARÉ du wallet
# personnel ci-dessus, avec un solde minimal (wallet "chaud" opérationnel, pas
# un coffre). AUTOSIGN_ENABLED doit rester à false tant que tu n'as pas validé
# le comportement en dry-run.
WALLET_AUTOSIGNER_ADDRESS=
WALLET_AUTOSIGNER_NETWORK=
WALLET_AUTOSIGNER_KEYSTORE_PATH=data/autosigner_keystore.json
WALLET_AUTOSIGNER_PASSPHRASE=
AUTOSIGN_ENABLED=false
# Adresses de contrats autorisées à être appelées automatiquement (séparées par
# des virgules). Vide par défaut = AUCUN contrat whitelisté = aucune tx possible.
AUTOSIGN_CONTRACT_WHITELIST=
AUTOSIGN_MAX_VALUE_NATIVE=0
AUTOSIGN_MAX_GAS_PRICE_GWEI=5
AUTOSIGN_MAX_TX_PER_DAY=3
# Marge minimale (EUR) exigée EN PLUS des frais de gas pour qu'un claim soit jugé
# rentable (section 16 étendue — micro-récompenses). 0 = le gain doit juste
# dépasser strictement les frais.
AUTOSIGN_MIN_PROFIT_MARGIN_EUR=0

# --- Prix (EUR) pour estimer la rentabilité d'un claim (facultatif) ---------
# ID CoinGecko (https://www.coingecko.com/, ex: "ethereum", "matic-network")
# du token NATIF (gas) de chaque réseau. Clé = PRICE_NATIVE_<NETWORK>, même
# normalisation que RPC_<NETWORK> ci-dessus. Si absent pour un réseau, le prix
# est considéré inconnu et AUCUN claim automatique n'est tenté dessus : on
# préfère rater une micro-récompense plutôt que deviner sa rentabilité.
PRICE_NATIVE_PUSH_CHAIN_DONUT_TESTNET=

# --- Dashboard (optionnel, si exposé au-delà du LAN) ------------------------
DASHBOARD_BASIC_AUTH_PASSWORD=

# Clés d'API de l'exchange (laisser vide en mode paper trading)
EXCHANGE_API_KEY=
EXCHANGE_API_SECRET=

# Notifications Telegram (optionnel)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Mot de passe du wallet on-chain BOT (chiffrement du keystore).
# Si vide, il sera demandé interactivement par les commandes wallet.
WALLET_PASSWORD=

# Mot de passe du wallet VAULT (coffre-fort). Ne le mets PAS ici sur le Pi en production :
# laisse vide, il sera demandé uniquement quand tu retires du vault.
VAULT_PASSWORD=

# Mot de passe du dashboard web (HTTP Basic). Vide = pas d'authentification (LAN de confiance uniquement).
WEB_PASSWORD=
